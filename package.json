{
  "name": "bewerbungs-pilot",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build -w web && npm run build -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "test": "npm run test -w server && npm run test -w web",
    "lint": "eslint .",
    "i18n:check": "node web/scripts/i18n-check.mjs",
    "release": "node scripts/release.mjs",
    "check:arbeitsagentur": "node scripts/check-arbeitsagentur.mjs",
    "check:pdf": "npm run check:pdf -w server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
